# Application
NODE_ENV=development
PORT=4000
APP_NAME=GAC Holidays API
API_PREFIX=/api/v1
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000,https://your-project.vercel.app

# Supabase PostgreSQL direct/pooler connection string.
# Prefer the transaction pooler URL for serverless deployments.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Supabase service credentials. Never expose the service-role key to the frontend.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Upstash Redis REST connection
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_redis_rest_token

# Admin authentication. Use an Argon2id hash, never plaintext.
ADMIN_USERNAME=gac_admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=1$replace_with_real_hash
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=19456,t=3,p=1$replace_with_real_hash
ADMIN_SESSION_TTL_HOURS=12
CUSTOMER_SESSION_TTL_DAYS=30
ENABLE_DUMMY_OTP_AUTH=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# WhatsApp/OTP variables are intentionally deferred to the later OTP phase.
