# Shared local configuration. Only REACT_APP_* values are included in the browser bundle;
# backend secrets must remain unprefixed and must never be committed with real values.
REACT_APP_API_URL=http://localhost:4000/api/v1
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=19456,t=3,p=1$replace_with_real_hash
