{
  "name": "gac-holidays-login",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-phone-input-2": "^2.15.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "concurrently --kill-others --names FRONTEND,BACKEND --prefix-colors blue,yellow \"npm:frontend\" \"npm:backend:dev\"",
    "frontend": "react-scripts start",
    "build": "react-scripts build",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:verify": "npm --prefix backend run verify:infra",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
